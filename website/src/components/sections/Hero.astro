---
import { Picture } from "astro:assets";
import Button from "../adwaita/Button.astro";
import sessionList from "../../assets/screenshots/session_list.png";
import sessionDetail from "../../assets/screenshots/session_detail.png";

const flathubUrl =
  "https://flathub.org/apps/io.github.supermaciz.sessionschronicle";
const githubUrl = "https://github.com/supermaciz/sessions-chronicle";
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow">OPEN SOURCE · LOCAL-FIRST · GTK 4</p>
      <h1 class="hero__title">Every conversation you've had with a machine.</h1>
      <p class="hero__sub">
        Sessions Chronicle indexes Claude Code, OpenCode, Codex, and Mistral
        Vibe transcripts on your disk into one searchable archive. Nothing
        leaves your machine.
      </p>
      <div class="hero__ctas">
        <Button variant="pill" href={flathubUrl}>Get on Flathub</Button>
        <Button variant="flat" href={githubUrl}>View on GitHub →</Button>
      </div>
      <p class="hero__meta">MIT · Flatpak · Linux</p>
    </div>

    <div class="hero__visual">
      <div class="hero__slot hero__slot--main">
        <Picture
          src={sessionDetail}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          widths={[400, 640, 960, 1280]}
          sizes="(max-width: 640px) 88vw, (max-width: 1023px) 70vw, 620px"
          loading="eager"
          fetchpriority="high"
          alt="A single Claude Code session showing tool calls inline"
        />
      </div>

      <div class="hero__slot hero__slot--overlay">
        <Picture
          src={sessionList}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          widths={[240, 360, 480, 720]}
          sizes="(max-width: 640px) 42vw, (max-width: 1023px) 28vw, 260px"
          loading="eager"
          alt="Sessions Chronicle main window listing recent AI assistant conversations"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
    background: var(--window-bg-color);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 40% 1fr;
      gap: var(--space-16);
    }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    font-size: clamp(36px, 5vw, var(--text-display));
    line-height: var(--line-tight);
    font-weight: 700;
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }
  .hero__sub {
    font-size: clamp(var(--text-body), 1.4vw, 18px);
    color: color-mix(in srgb, var(--window-fg-color) 80%, transparent);
    margin-bottom: var(--space-6);
    max-width: 42ch;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .hero__meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--window-fg-color) 55%, transparent);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }
  .hero__slot {
    overflow: visible;
  }
  .hero__slot--main {
    position: relative;
    width: 84%;
    z-index: 1;
  }
  .hero__slot :global(picture) {
    display: block;
    width: 100%;
    line-height: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent-bg-color) 42%, white);
  }
  .hero__slot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__slot--overlay {
    position: absolute;
    right: 0;
    bottom: 2%;
    width: 38%;
    z-index: 2;
  }

  @media (max-width: 1023px) {
    .hero__visual {
      max-width: 640px;
    }
    .hero__slot--main {
      width: 86%;
    }
    .hero__slot--overlay {
      width: 40%;
      bottom: 1%;
    }
  }
  @media (max-width: 640px) {
    .hero__slot--main {
      width: 88%;
    }
    .hero__slot--overlay {
      width: 44%;
      right: 0;
      bottom: 0;
    }
  }
</style>
