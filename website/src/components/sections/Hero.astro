---
import { Picture } from 'astro:assets';
import Button from '../adwaita/Button.astro';
import Card from '../adwaita/Card.astro';
import sessionList from '../../assets/screenshots/session_list.png';
import sessionDetail from '../../assets/screenshots/session_detail.png';

const flathubUrl = 'https://flathub.org/apps/io.github.supermaciz.sessionschronicle';
const githubUrl = 'https://github.com/supermaciz/sessions-chronicle';
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow">OPEN SOURCE · LOCAL-FIRST · GTK 4</p>
      <h1 class="hero__title">Every conversation you've had with a machine.</h1>
      <p class="hero__sub">
        Sessions Chronicle indexes Claude Code, OpenCode, Codex, and Mistral Vibe
        transcripts on your disk into one searchable archive. Nothing leaves your machine.
      </p>
      <div class="hero__ctas">
        <Button variant="pill" href={flathubUrl}>Get on Flathub</Button>
        <Button variant="flat" href={githubUrl}>View on GitHub →</Button>
      </div>
      <p class="hero__meta">MIT · Flatpak · Linux</p>
    </div>

    <div class="hero__visual">
      <Card elevated padding="none" class="hero__frame hero__frame--main">
        <Picture
          src={sessionList}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[640, 1024, 1280]}
          sizes="(max-width: 768px) 100vw, 640px"
          loading="eager"
          fetchpriority="high"
          alt="Sessions Chronicle main window listing recent AI assistant conversations"
        />
      </Card>

      <Card elevated padding="none" class="hero__frame hero__frame--overlay">
        <Picture
          src={sessionDetail}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[400, 720, 960]}
          sizes="(max-width: 768px) 62vw, 360px"
          loading="eager"
          alt="A single Claude Code session showing tool calls inline"
        />
      </Card>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
    background: var(--window-bg-color);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: 40% 1fr; gap: var(--space-16); }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    font-size: clamp(36px, 5vw, var(--text-display));
    line-height: var(--line-tight);
    font-weight: 700;
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }
  .hero__sub {
    font-size: clamp(var(--text-body), 1.4vw, 18px);
    color: color-mix(in srgb, var(--window-fg-color) 80%, transparent);
    margin-bottom: var(--space-6);
    max-width: 42ch;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .hero__meta {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--window-fg-color) 55%, transparent);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 780px;
    aspect-ratio: 16 / 10;
    margin-inline: auto;
    padding: 0 0 44px;
  }
  .hero__frame {
    overflow: hidden;
  }
  .hero__frame--main {
    position: relative;
    width: 84%;
    height: 100%;
    aspect-ratio: 16 / 10;
  }
  .hero__frame :global(picture),
  .hero__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__frame :global(img) {
    object-fit: cover;
  }
  .hero__frame--main :global(img) {
    object-position: center top;
  }
  .hero__frame--overlay {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(200px, 42%, 320px);
    aspect-ratio: 16 / 10;
  }
  .hero__frame--overlay :global(img) {
    object-position: center top;
  }

  @media (max-width: 1023px) {
    .hero__visual {
      max-width: 640px;
      padding-bottom: 34px;
    }
    .hero__frame--main {
      width: 88%;
    }
    .hero__frame--overlay {
      width: clamp(170px, 40%, 250px);
    }
  }
  @media (max-width: 640px) {
    .hero__visual {
      aspect-ratio: 4 / 3;
      padding-bottom: 18px;
    }
    .hero__frame--main {
      width: 92%;
    }
    .hero__frame--overlay {
      width: 54%;
    }
  }
</style>
