<?xml version="1.0" encoding="UTF-8" ?>
<!-- Mathieu Cizo 2019 <maciz@outlook.fr> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <project_license>MIT</project_license>
  <name>Sessions Chronicle</name>
  <summary>Browse and search AI coding sessions</summary>
  <description>
    <p
        >Sessions Chronicle is a GNOME application for browsing, searching, and resuming AI coding sessions.</p>
    <p
        >It indexes local session files in SQLite (FTS5) and supports Claude Code, OpenCode, Codex, Mistral Vibe, and Kimi Code formats.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image
            >https://raw.githubusercontent.com/supermaciz/sessions-chronicle/main/website/src/assets/screenshots/session_list.png</image>
      <caption>Session list view</caption>
    </screenshot>
    <screenshot>
      <image
            >https://raw.githubusercontent.com/supermaciz/sessions-chronicle/main/website/src/assets/screenshots/session_detail.png</image>
      <caption>Session detail view</caption>
    </screenshot>
    <screenshot>
      <image
            >https://raw.githubusercontent.com/supermaciz/sessions-chronicle/main/website/src/assets/screenshots/analytics_light.png</image>
      <caption>Analytics dashboard with usage statistics</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://sessions-chronicle.maciz.dev</url>
  <url
        type="bugtracker"
    >https://github.com/supermaciz/sessions-chronicle/issues</url>
  <!-- Source code repository -->
  <url type="vcs-browser">https://github.com/supermaciz/sessions-chronicle</url>
  <!-- Translation repository -->
  <url
        type="translate"
    >https://github.com/supermaciz/sessions-chronicle/tree/main/po</url>
  <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
  <categories>
    <category>Development</category>
    <category>GTK</category>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.10.0" date="2026-08-05">
      <description>
        <p>Adds GNOME search provider integration, session deep-linking, and Kimi Code support.</p>
        <ul>
          <li>Expose session search in GNOME Activities with the new search provider</li>
          <li>Open indexed sessions directly via app action deep-links</li>
          <li>Add Kimi Code session format support</li>
          <li>Skip Claude Code sessions containing only synthetic assistant events</li>
        </ul>
      </description>
    </release>
    <release version="0.9.0" date="2026-07-29">
      <description>
        <p>Improves session organization, date filtering, and Claude Code subagent support.</p>
        <ul>
          <li>Add configurable session-list sorting</li>
          <li>Replace the custom date-range editor with a simpler endpoint picker</li>
          <li>Restore Claude Code teammate subagent linkage for version 2.1.216 and newer</li>
        </ul>
      </description>
    </release>
    <release version="0.8.0" date="2026-07-17">
      <description>
        <p>Introduces a new Markdown renderer and raw text toggle for transcripts.</p>
        <ul>
          <li>New Markdown renderer with GtkLabel-based layout and horizontally scrollable tables</li>
          <li>Add per-row raw text toggle for assistant messages</li>
        </ul>
      </description>
    </release>
    <release version="0.7.1" date="2026-06-18">
      <description>
        <p>A patch release with a date filter addition and transcript interaction fix.</p>
        <ul>
          <li>Add Yesterday option to the date filter pill</li>
          <li>Fix scroll position and message expansion on first click in transcript rows</li>
        </ul>
      </description>
    </release>
    <release version="0.7.0" date="2026-06-14">
      <description>
        <p>Improves session indexing for Mistral Vibe and Codex, adds richer tool category icons, and polishes the inspector sidebar.</p>
        <ul>
          <li>Index Mistral Vibe subagent sessions and link them to parent task tool calls</li>
          <li>Support archived Codex rollout sessions and refreshed Mistral Vibe session formats</li>
          <li>Show richer tool category icons for planning, skill, and user-input tools</li>
          <li>Reset inspector scroll position when switching between tool calls and subagents</li>
          <li>Remove the unused Inner Tools section from the inspector sidebar</li>
        </ul>
      </description>
    </release>
    <release version="0.6.1" date="2026-06-07">
      <description>
        <p>Polishes the inspector sidebar and session summary UI.</p>
        <ul>
          <li>Fix inspector sidebar pinning so navigation no longer opens an empty pane</li>
          <li>Add speaker-notes icon to the session summary button</li>
          <li>Update to relm4 0.11 targeting GNOME 50</li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-06-06">
      <description>
        <p>Moves session summary to a header popover for better space utilization.</p>
        <ul>
          <li>Session summary now appears in a convenient header popover</li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-05-29">
      <description>
        <p>Introduces date filtering and a cleaner sidebar for session browsing.</p>
        <ul>
          <li>Add date filter pill to browse sessions by time range</li>
          <li>Browse and filter sessions with a cleaner, decluttered sidebar</li>
        </ul>
      </description>
    </release>
    <release version="0.4.11" date="2026-05-26">
      <description>
        <p>Improves indexing and transcript rendering stability across AI assistant session formats.</p>
        <ul>
          <li>Preserve session list scroll position after indexing</li>
          <li>Update Codex subagent parsing for collab_resume_end and response-item subagents</li>
          <li>Fix encrypted reasoning pill visibility in light mode</li>
        </ul>
      </description>
    </release>
    <release version="0.4.10" date="2026-05-18">
      <description>
        <p>Improves transcript rendering performance in session detail view.</p>
        <ul>
          <li>Faster and smoother transcript scrolling in session detail</li>
        </ul>
      </description>
    </release>
    <release version="0.4.9" date="2026-05-08">
      <description>
        <p>Improves session list indexing performance and fixes visual glitches.</p>
        <ul>
          <li>Batch post-indexing session list inserts for faster startup</li>
          <li>Stop excess vertical space below markdown tables in transcripts</li>
          <li>Reduce minimum window width to 710px</li>
        </ul>
      </description>
    </release>
    <release version="0.4.8" date="2026-05-14">
      <description>
        <p>Adds explicit session ID search and FTS-backed pagination for session search.</p>
        <ul>
          <li>Add explicit session ID search in session list</li>
          <li>Implement FTS-backed session search pagination</li>
        </ul>
      </description>
    </release>
    <release version="0.4.7" date="2026-04-29">
      <description>
        <p>Improves session detail smoothness and panel layout.</p>
        <ul>
          <li>Improve render fluidity in session detail view</li>
          <li>Split filters and inspector into independent panes</li>
        </ul>
      </description>
    </release>
    <release version="0.4.6" date="2026-04-26">
      <description>
        <p>Improves large session responsiveness and release publishing metadata.</p>
        <ul>
          <li>Speed up large session detail loading</li>
          <li>Add self-hosted Flatpak repository publishing workflow</li>
          <li>Point homepage links to the product website</li>
        </ul>
      </description>
    </release>
    <release version="0.4.5" date="2026-04-24">
      <description>
        <p>Adds Codex and Claude Code subagent linkage and improves UI responsiveness.</p>
        <ul>
          <li>Link Claude Code subagent transcripts to child sessions</li>
          <li>Link Codex subagent tool calls to child sessions</li>
          <li>Wrap tool-burst header pills for better narrow-window layout</li>
          <li>Keep reasoning pills left-aligned in transcript rows</li>
          <li>Use dynamic agent icons and expand Web tool category recognition</li>
        </ul>
      </description>
    </release>
    <release version="0.4.4" date="2026-04-16">
      <description>
        <p>Improves transcript rendering, OpenCode parsing, and indexing reliability.</p>
        <ul>
          <li>Add syntax highlighting for markdown code blocks in transcripts</li>
          <li>Parse OpenCode task tool calls as subagent activity and deduplicate subtask entries</li>
          <li>Fix spacing around markdown tables and code blocks</li>
          <li>Rebuild stale override fixture transcripts when indexed session data changes</li>
        </ul>
      </description>
    </release>
    <release version="0.4.3" date="2026-04-06">
      <description>
        <p>Adds transcript reasoning pills and encrypted presence support.</p>
        <ul>
          <li>Add reasoning pills to transcript rows for quick navigation to reasoning blocks</li>
          <li>Support encrypted presence detection</li>
        </ul>
      </description>
    </release>
    <release version="0.4.2" date="2026-04-05">
      <description>
        <p>Adds session pinning and improves transcript readability.</p>
        <ul>
          <li>Pin favorite sessions and filter to pinned-only in the sidebar</li>
          <li>Group consecutive tool calls in the session detail view</li>
          <li>Fix parser correctness drift regressions</li>
        </ul>
      </description>
    </release>
    <release version="0.4.1" date="2026-03-31">
      <description>
        <p>Improves session list readability and detail headers.</p>
        <ul>
          <li>Add structured summary header to session detail view</li>
          <li>Show message count, activity count, and ending status in session rows</li>
          <li>Streamline AI assistant filter rows in the sidebar</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-03-26">
      <description>
        <p>Adds detailed indexing status diagnostics and project-aware session organization.</p>
        <ul>
          <li>Add Indexing Status dialog with per-source summaries and recent errors</li>
          <li>Add direct re-index action from the indexing status dialog</li>
          <li>Add project detection and sidebar project filters for cross-filtered session browsing</li>
        </ul>
      </description>
    </release>
    <release version="0.3.5" date="2026-03-15">
      <description>
        <p>Fixes Codex session resumption.</p>
        <ul>
          <li>Fix resuming Codex sessions from the session detail view</li>
        </ul>
      </description>
    </release>
    <release version="0.3.4" date="2026-03-14">
      <description>
        <p>Adds token cache analytics and cleans up session titles.</p>
        <ul>
          <li>Show cache creation, read, and reasoning tokens in analytics</li>
          <li>Strip command tags from session titles for cleaner display</li>
          <li>Filters pane now stays open by default on the session list</li>
        </ul>
      </description>
    </release>
    <release version="0.3.3" date="2026-03-09">
      <description>
        <p>Adds an analytics dashboard and improves the tool call inspector.</p>
        <ul>
          <li>Add basic analytics dashboard with usage charts</li>
          <li
                    >Upgrade tool call inspector with specialized renderers and rich previews</li>
          <li>Fix token semantics error handling</li>
        </ul>
      </description>
    </release>
    <release version="0.3.2" date="2026-03-01">
      <description>
        <p>Improves reliability of OpenCode session indexing.</p>
        <ul>
          <li>OpenCode sessions are now re-indexed when updated</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-03-01">
      <description>
        <p>Improves startup performance.</p>
        <ul>
          <li>Speed up startup with background incremental indexing</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-02-28">
      <description>
        <p>Improves session details and transcript readability.</p>
        <ul>
          <li>Show per-session token usage in Session Detail</li>
          <li>Improve markdown rendering in transcripts</li>
        </ul>
      </description>
    </release>
    <release version="0.2.2" date="2026-02-26">
      <description>
        <p>Improves navigation and model visibility.</p>
        <ul>
          <li>Add keyboard navigation in the session list</li>
          <li>Show assistant model slug in transcript headers</li>
          <li>Fix nested list rendering in transcripts</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-02-22" />
    <release version="0.2.0" date="2026-02-19" />
    <release version="0.1.1" date="2026-02-17" />
    <release version="0.1.0" date="2026-02-14" />
  </releases>
  <kudos>
     <!--
       GNOME Software kudos:
       https://gitlab.gnome.org/GNOME/gnome-software/-/blob/main/doc/kudos.md
     -->
     <kudo>ModernToolkit</kudo>
     <kudo>HiDpiIcon</kudo>
  </kudos>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Mathieu Cizo</developer_name>
  <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
  <developer id="io.github.supermaciz">
    <name translate="no">Mathieu Cizo</name>
  </developer>
  <!--
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>
  <update_contact>maciz@outlook.fr</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
